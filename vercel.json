{
  "version": 2,
  "builds": [
    {
      "src": "demo/portal/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "demo/portal/assets/$1"
    },
    {
      "src": "/VICT-Technical-Whitepaper.txt",
      "dest": "demo/portal/VICT-Technical-Whitepaper.txt"
    },
    {
      "src": "/(demo|how-it-works|nbfc|regulation|self-host)(\\.html)?/?",
      "dest": "demo/portal/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "demo/portal/index.html"
    }
  ]
}
